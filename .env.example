# System Environment Configuration
API_KEY=your_system_api_key_here
FLASK_ENV=development
HOST=0.0.0.0
PORT=5000

# Database Configuration (Optional; defaults to SQLite if omitted)
# DATABASE_URL=postgresql://user:password@localhost:5432/comment_filter_db

# Razorpay Integration Secrets
RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Firebase Admin SDK Configuration (JSON string or file path)
GOOGLE_APPLICATION_CREDENTIALS=path/to/firebase-credentials.json
